{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "sbox",
  "version": "../../../package.json",
  "identifier": "com.while.sbox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1400",
    "beforeDevCommand": "node src-tauri/native/sync-icons.cjs && pnpm --filter @sbox/app exec vite dev --port 1400",
    "beforeBuildCommand": "node src-tauri/native/sync-icons.cjs && pnpm --filter @sbox/app exec vite build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "sbox",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "while",
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "../../icon/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEN0M3NkIyM0MwRUFEQzYKUldUR3JRNDhzblo4alZ4dVRCUHJzekJPUUgwUG9SaVdJT2hDcytnQStBdkY2UkxhN1FhMUxvN1AK",
      "endpoints": [
        "https://github.com/while-coder/sbox/releases/download/updater/latest.json"
      ]
    }
  }
}
