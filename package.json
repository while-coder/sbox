{
  "name": "sbox-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @sbox/app dev",
    "dev:app:mac": "pnpm --filter @sbox/app macos:dev",
    "build:app": "pnpm --filter @sbox/app windows:build",
    "build:app:mac": "pnpm --filter @sbox/app macos:build",
    "tauri": "pnpm --filter @sbox/app tauri",
    "debug:app": "cargo build --manifest-path packages/app/src-tauri/Cargo.toml --no-default-features",
    "release": "node scripts/release.cjs",
    "sync:versions": "node scripts/sync-versions.cjs",
    "sync:icons": "node scripts/sync-icons.cjs",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "dev:web": "pnpm --filter @sbox/app web:dev",
    "build:web": "pnpm --filter @sbox/app web:build",
    "check:ui": "pnpm --filter @sbox/ui check",
    "check:app": "pnpm --filter @sbox/app check"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
